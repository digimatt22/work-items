    "AUTH_URL",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
    "STORAGE_PROVIDER",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE"
  ]
}
