{
  "schema": 1,
  "name": "digicolony-client-ops",
  "hostname": "portal.digicolony.net",
  "framework": "nextjs",
  "container_port": 3000,
  "host_port": null,
  "health_path": "/api/health",
  "dockerfile": "Dockerfile",
  "release": {
    "generated_allowlist": []
  },
  "inventory": {
    "resource_limits_required": true,
    "resource_budget": {
      "memory_bytes": 2147483648,
      "nano_cpus": 1500000000,
      "pids": 256
    },
    "release_retention": 5,
    "volumes": ["sheldon-garage-meta", "sheldon-garage-data"],
    "backup": {
      "required": true,
      "max_age_hours": 168,
      "owner": "mwood"
    },
    "database": {
      "cluster": "rootful-shared-postgres",
      "database": "appdb",
      "runtime_role": "appuser",
      "isolation_tier": "ordinary-internal"
    },
    "storage": [
      {
        "name": "work-items-private",
        "profile": "garage",
        "owner": "digicolony-client-ops"
      }
    ]
  },
  "requires_env": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_TRUST_HOST",
    "AUTH_URL",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
    "STORAGE_PROVIDER",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "DIGI_PORTAL_PLATFORM_URL",
    "DIGI_PORTAL_ADMIN_BINDINGS_ENABLED",
    "DIGI_PORTAL_AGENT_READS_ENABLED",
    "DIGI_PORTAL_AGENT_MUTATIONS_ENABLED"
  ]
}
