{
  "schema": 1,
  "name": "digicolony-client-ops",
  "hostname": "portal.digicolony.net",
  "framework": "nextjs",
  "container_port": 3000,
  "host_port": null,
  "health_path": "/api/health",
  "dockerfile": "Dockerfile",
  "requires_env": [
    "DATABASE_URL",
    "AUTH_SECRET",
