generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT_USER
}

enum ActorType {
  USER
  AI_AGENT
  SYSTEM
}

enum ActivityVisibility {
  USER_VISIBLE
  ADMIN_ONLY
}

enum WorkItemType {
  BUG
  FEATURE
}

enum AssetProvider {
  LOCAL
  S3
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole            @default(CLIENT_USER)
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id])
  accounts           Account[]
  sessions           Session[]
  passwordCredential PasswordCredential?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  createdWorkItems   WorkItem[]      @relation("WorkItemCreator")
  reportedWorkItems  WorkItem[]      @relation("WorkItemReporter")
  assignedWorkItems  WorkItem[]      @relation("WorkItemAssignee")
  projectMemberships ProjectMember[]
  comments           Comment[]
  mentions           Mention[]
  watchedWorkItems   Watcher[]
}

model PasswordCredential {
  id                 String   @id @default(cuid())
  userId             String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id                String    @id @default(cuid())
  name              String
  description       String?
  structuredContext Json?
  aiContext         Json?
  aiSummary         String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users    User[]
  projects Project[]
}

model Project {
  id                String    @id @default(cuid())
  clientId          String
  name              String
  description       String?
  structuredContext Json?
  aiContext         Json?
  aiSummary         String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client         Client          @relation(fields: [clientId], references: [id])
  members        ProjectMember[]
  workItems      WorkItem[]
  releaseTargets ReleaseTarget[]
  assets         AssetLink[]
}

model ProjectMember {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model PipelineStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  color     String
  sortOrder Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems WorkItem[]
}

model ReleaseTarget {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  date       DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id])
  workItems WorkItem[]
}

model WorkItem {
  id                String       @id @default(cuid())
  projectId         String
  type              WorkItemType
  title             String
  description       String
  structuredContext Json?
  aiContext         Json?
  aiSummary         String?
  creatorId         String
  reporterId        String
  assigneeId        String?
  pipelineStatusId  String
  releaseTargetId   String?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project        Project                 @relation(fields: [projectId], references: [id])
  creator        User                    @relation("WorkItemCreator", fields: [creatorId], references: [id])
  reporter       User                    @relation("WorkItemReporter", fields: [reporterId], references: [id])
  assignee       User?                   @relation("WorkItemAssignee", fields: [assigneeId], references: [id])
  pipelineStatus PipelineStatus          @relation(fields: [pipelineStatusId], references: [id])
  releaseTarget  ReleaseTarget?          @relation(fields: [releaseTargetId], references: [id])
  bugDetails     WorkItemBugDetails?
  featureDetails WorkItemFeatureDetails?
  comments       Comment[]
  labels         WorkItemLabel[]
  watchers       Watcher[]
  assets         AssetLink[]
}

model WorkItemBugDetails {
  id               String   @id @default(cuid())
  workItemId       String   @unique
  stepsToReproduce String
  expectedBehavior String
  actualBehavior   String
  workItem         WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
}

model WorkItemFeatureDetails {
  id                 String   @id @default(cuid())
  workItemId         String   @unique
  userStory          String
  acceptanceCriteria String
  businessValue      String
  workItem           WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String   @id @default(cuid())
  workItemId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem WorkItem  @relation(fields: [workItemId], references: [id])
  author   User      @relation(fields: [authorId], references: [id])
  mentions Mention[]
}

model Mention {
  id              String   @id @default(cuid())
  commentId       String
  mentionedUserId String?
  token           String
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User?   @relation(fields: [mentionedUserId], references: [id], onDelete: SetNull)
}

model Label {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems WorkItemLabel[]
}

model WorkItemLabel {
  workItemId String
  labelId    String

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  label    Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([workItemId, labelId])
}

model Watcher {
  workItemId String
  userId     String
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workItemId, userId])
}

model Asset {
  id          String        @id @default(cuid())
  provider    AssetProvider @default(LOCAL)
  objectKey   String
  filename    String
  contentType String
  sizeBytes   Int
  checksum    String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  links AssetLink[]
}

model AssetLink {
  id         String   @id @default(cuid())
  assetId    String
  projectId  String?
  workItemId String?
  createdAt  DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  workItem WorkItem? @relation(fields: [workItemId], references: [id])
}

model ActivityEvent {
  id         String             @id @default(cuid())
  actorType  ActorType
  actorId    String
  entityType String
  entityId   String
  action     String
  visibility ActivityVisibility
  metadata   Json?
  createdAt  DateTime           @default(now())

  aiAction AiAction?
}

model AiAction {
  id                 String   @id @default(cuid())
  activityEventId    String   @unique
  agentId            String
  toolName           String
  authorizationScope Json
  decisionSummary    String?
  resultSummary      String?
  metadata           Json?
  createdAt          DateTime @default(now())

  activityEvent ActivityEvent @relation(fields: [activityEventId], references: [id], onDelete: Cascade)
}

model McpOAuthClient {
  id               String    @id @default(cuid())
  name             String
  clientId         String    @unique
  clientSecretHash String
  scopes           Json
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
