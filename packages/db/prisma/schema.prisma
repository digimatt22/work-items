generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT_USER
}

enum ActorType {
  USER
  AI_AGENT
  SYSTEM
}

enum ActivityVisibility {
  USER_VISIBLE
  ADMIN_ONLY
}

enum WorkItemType {
  BUG
  FEATURE
}

enum AssetProvider {
  LOCAL
  S3
}

enum ProjectBindingKind {
  CODEX_WORKSPACE
}

enum ProjectBindingEnvironment {
  DEVELOPMENT
  PILOT
  PRODUCTION
}

enum ProjectBindingStatus {
  PENDING
  VERIFIED
  ACTIVE
  REVOKED
}

enum WorkQualificationState {
  READY
  REVOKED
}

enum WorkSensitivity {
  NORMAL
  SENSITIVE
  RESTRICTED
}

enum AgentDispatchState {
  QUEUED
  CLAIMED
  BLOCKED
  READY_FOR_REVIEW
  COMPLETED
  CANCELLED
  QUARANTINED
}

enum DeliveryAttemptState {
  IN_PROGRESS
  BLOCKED
  READY_FOR_REVIEW
  COMPLETED
  ABANDONED
  EXPIRED
}

enum DeliveryEvidenceKind {
  SUMMARY
  COMMIT
  BRANCH
  PULL_REQUEST
  TEST_RESULT
  SCREENSHOT
  DOCUMENT
  NOTE
}

enum OutboxEventState {
  PENDING
  PUBLISHED
  FAILED
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole            @default(CLIENT_USER)
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id])
  accounts           Account[]
  sessions           Session[]
  passwordCredential PasswordCredential?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  createdWorkItems       WorkItem[]             @relation("WorkItemCreator")
  reportedWorkItems      WorkItem[]             @relation("WorkItemReporter")
  assignedWorkItems      WorkItem[]             @relation("WorkItemAssignee")
  projectMemberships     ProjectMember[]
  comments               Comment[]
  mentions               Mention[]
  watchedWorkItems       Watcher[]
  createdProjectBindings ProjectBinding[]       @relation("ProjectBindingCreator")
  workQualifications     WorkQualification[]    @relation("WorkQualificationAdmin")
  mcpAuthorizationCodes  McpAuthorizationCode[]
  mcpAccessGrants        McpAccessGrant[]
}

model PasswordCredential {
  id                 String   @id @default(cuid())
  userId             String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id                String    @id @default(cuid())
  name              String
  description       String?
  structuredContext Json?
  aiContext         Json?
  aiSummary         String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users    User[]
  projects Project[]
}

model Project {
  id                String    @id @default(cuid())
  clientId          String
  name              String
  description       String?
  structuredContext Json?
  aiContext         Json?
  aiSummary         String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client          Client           @relation(fields: [clientId], references: [id])
  members         ProjectMember[]
  workItems       WorkItem[]
  releaseTargets  ReleaseTarget[]
  assets          AssetLink[]
  projectBindings ProjectBinding[]
}

model ProjectMember {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model PipelineStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  color     String
  sortOrder Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems WorkItem[]
}

model ReleaseTarget {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  date       DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id])
  workItems WorkItem[]
}

model WorkItem {
  id                String       @id @default(cuid())
  projectId         String
  type              WorkItemType
  title             String
  description       String
  structuredContext Json?
  aiContext         Json?
  aiSummary         String?
  creatorId         String
  reporterId        String
  assigneeId        String?
  pipelineStatusId  String
  releaseTargetId   String?
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project        Project                 @relation(fields: [projectId], references: [id])
  creator        User                    @relation("WorkItemCreator", fields: [creatorId], references: [id])
  reporter       User                    @relation("WorkItemReporter", fields: [reporterId], references: [id])
  assignee       User?                   @relation("WorkItemAssignee", fields: [assigneeId], references: [id])
  pipelineStatus PipelineStatus          @relation(fields: [pipelineStatusId], references: [id])
  releaseTarget  ReleaseTarget?          @relation(fields: [releaseTargetId], references: [id])
  bugDetails     WorkItemBugDetails?
  featureDetails WorkItemFeatureDetails?
  comments       Comment[]
  labels         WorkItemLabel[]
  watchers       Watcher[]
  assets         AssetLink[]
  qualifications WorkQualification[]
  agentDispatch  AgentDispatch?
}

model WorkItemBugDetails {
  id               String   @id @default(cuid())
  workItemId       String   @unique
  stepsToReproduce String
  expectedBehavior String
  actualBehavior   String
  workItem         WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
}

model WorkItemFeatureDetails {
  id                 String   @id @default(cuid())
  workItemId         String   @unique
  userStory          String
  acceptanceCriteria String
  businessValue      String
  workItem           WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String   @id @default(cuid())
  workItemId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem WorkItem  @relation(fields: [workItemId], references: [id])
  author   User      @relation(fields: [authorId], references: [id])
  mentions Mention[]
}

model Mention {
  id              String   @id @default(cuid())
  commentId       String
  mentionedUserId String?
  token           String
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User?   @relation(fields: [mentionedUserId], references: [id], onDelete: SetNull)
}

model Label {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems WorkItemLabel[]
}

model WorkItemLabel {
  workItemId String
  labelId    String

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  label    Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([workItemId, labelId])
}

model Watcher {
  workItemId String
  userId     String
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workItemId, userId])
}

model Asset {
  id          String        @id @default(cuid())
  provider    AssetProvider @default(LOCAL)
  objectKey   String
  filename    String
  contentType String
  sizeBytes   Int
  checksum    String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  links AssetLink[]
}

model AssetLink {
  id         String   @id @default(cuid())
  assetId    String
  projectId  String?
  workItemId String?
  createdAt  DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  workItem WorkItem? @relation(fields: [workItemId], references: [id])
}

model ActivityEvent {
  id         String             @id @default(cuid())
  actorType  ActorType
  actorId    String
  entityType String
  entityId   String
  action     String
  visibility ActivityVisibility
  metadata   Json?
  createdAt  DateTime           @default(now())

  aiAction AiAction?
}

model AiAction {
  id                 String   @id @default(cuid())
  activityEventId    String   @unique
  agentId            String
  toolName           String
  authorizationScope Json
  decisionSummary    String?
  resultSummary      String?
  metadata           Json?
  createdAt          DateTime @default(now())

  activityEvent ActivityEvent @relation(fields: [activityEventId], references: [id], onDelete: Cascade)
}

model McpOAuthClient {
  id                      String    @id @default(cuid())
  name                    String
  clientId                String    @unique
  clientSecretHash        String?
  redirectUris            Json      @default("[]")
  tokenEndpointAuthMethod String    @default("none")
  scopes                  Json
  revokedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  projectBindings    ProjectBinding[]
  authorizationCodes McpAuthorizationCode[]
  accessGrants       McpAccessGrant[]
}

model ProjectBinding {
  id                String                    @id
  projectId         String
  oauthClientId     String?
  createdById       String
  kind              ProjectBindingKind        @default(CODEX_WORKSPACE)
  environment       ProjectBindingEnvironment
  status            ProjectBindingStatus      @default(PENDING)
  platformUrl       String
  repositoryRef     String
  workspaceRef      String?
  configFingerprint String
  activeKey         String?                   @unique
  verifiedAt        DateTime?
  activatedAt       DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  project            Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  oauthClient        McpOAuthClient?        @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)
  createdBy          User                   @relation("ProjectBindingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  dispatches         AgentDispatch[]
  authorizationCodes McpAuthorizationCode[]
  accessGrants       McpAccessGrant[]

  @@index([projectId, status])
  @@index([status, environment])
}

model McpAuthorizationCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  oauthClientId String
  bindingId     String
  userId        String
  redirectUri   String
  scopes        Json
  codeChallenge String
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  oauthClient McpOAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  binding     ProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([oauthClientId, expiresAt])
  @@index([bindingId, expiresAt])
}

model McpAccessGrant {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  oauthClientId String
  bindingId     String
  userId        String
  agentId       String
  scopes        Json
  resource      String
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  oauthClient McpOAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Restrict)
  binding     ProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bindingId, revokedAt, expiresAt])
  @@index([oauthClientId, revokedAt])
}

model WorkQualification {
  id                  String                 @id @default(cuid())
  workItemId          String
  version             Int
  state               WorkQualificationState @default(READY)
  acceptanceCriteria  String
  implementationNotes String?
  sensitivity         WorkSensitivity        @default(NORMAL)
  qualifiedById       String
  createdAt           DateTime               @default(now())
  revokedAt           DateTime?

  workItem    WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  qualifiedBy User           @relation("WorkQualificationAdmin", fields: [qualifiedById], references: [id], onDelete: Restrict)
  dispatch    AgentDispatch?

  @@unique([workItemId, version])
  @@index([workItemId, state, createdAt])
}

model AgentDispatch {
  id              String             @id @default(cuid())
  workItemId      String             @unique
  bindingId       String
  qualificationId String             @unique
  state           AgentDispatchState @default(QUEUED)
  priority        Int                @default(0)
  availableAt     DateTime           @default(now())
  version         Int                @default(1)
  lastErrorCode   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workItem      WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  binding       ProjectBinding    @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  qualification WorkQualification @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  claims        AgentClaim[]
  attempts      DeliveryAttempt[]

  @@index([bindingId, state, priority, availableAt])
}

model AgentClaim {
  id              String    @id @default(cuid())
  dispatchId      String
  agentId         String
  leaseTokenHash  String
  activeKey       String?   @unique
  claimedAt       DateTime  @default(now())
  expiresAt       DateTime
  lastHeartbeatAt DateTime  @default(now())
  releasedAt      DateTime?
  releaseReason   String?

  dispatch AgentDispatch    @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  attempt  DeliveryAttempt?

  @@index([dispatchId, releasedAt])
  @@index([expiresAt, releasedAt])
}

model DeliveryAttempt {
  id         String               @id @default(cuid())
  dispatchId String
  claimId    String               @unique
  sequence   Int
  state      DeliveryAttemptState @default(IN_PROGRESS)
  summary    String?
  startedAt  DateTime             @default(now())
  finishedAt DateTime?

  dispatch AgentDispatch      @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  claim    AgentClaim         @relation(fields: [claimId], references: [id], onDelete: Restrict)
  evidence DeliveryEvidence[]

  @@unique([dispatchId, sequence])
  @@index([dispatchId, state])
}

model DeliveryEvidence {
  id        String               @id @default(cuid())
  attemptId String
  kind      DeliveryEvidenceKind
  label     String
  uri       String?
  metadata  Json?
  createdAt DateTime             @default(now())

  attempt DeliveryAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([attemptId, createdAt])
}

model OutboxEvent {
  id            String           @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  state         OutboxEventState @default(PENDING)
  attempts      Int              @default(0)
  availableAt   DateTime         @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([state, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}
