{
  "name": "@digicolony/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:review:reset": "prisma db push --schema prisma/schema.prisma --force-reset --accept-data-loss && tsx prisma/seed.ts",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "storage:verify-isolation": "tsx scripts/verify-garage-bucket-isolation.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@digicolony/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.22.4"
  }
}
