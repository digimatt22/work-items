{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.digicolony.net/schemas/digi-portal-project.schema.json",
  "title": "Digi-Portal Project Binding",
  "description": "Non-secret project identity used by the Digi-Portal plugin. Credentials must be stored by the connector host, never in this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugin",
    "platformUrl",
    "projectId",
    "bindingId",
    "environment",
    "repositoryRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugin": {
      "const": "digi-portal"
    },
    "platformUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^(https://|http://localhost(?::[0-9]+)?(?:/|$))"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "bindingId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": ["DEVELOPMENT", "PILOT", "PRODUCTION"]
    },
    "repositoryRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
